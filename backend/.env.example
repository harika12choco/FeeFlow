# FeeFlow backend configuration
# Copy to .env and adjust. Do NOT commit the real .env.

# Database. Defaults to a local SQLite file if unset.
# For PostgreSQL use e.g. postgresql+psycopg://user:pass@localhost:5432/feeflow
DATABASE_URL=sqlite:///./feeflow.db

# JWT signing secret. CHANGE THIS in any real deployment.
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRE_MINUTES=720

# CORS origins for the frontend dev server (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional LLM provider for AI dropout-risk assessment.
# If unset or unreachable, FeeFlow uses a transparent deterministic (rule-based) fallback.
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
